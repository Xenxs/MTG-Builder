<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MTGDeckbuilder.Desktop.ViewModels" xmlns:app="using:MTGDeckbuilder.Application" x:Class="MTGDeckbuilder.Desktop.Views.DeckWizardView" x:DataType="vm:DeckWizardViewModel">
 <UserControl.DataTemplates><DataTemplate DataType="app:CardChoice" x:DataType="app:CardChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate><DataTemplate DataType="app:PaperCard" x:DataType="app:PaperCard"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></UserControl.DataTemplates>
 <StackPanel Spacing="20">
  <Grid ColumnDefinitions="*,70"><StackPanel Spacing="8"><TextBlock Text="Smeed je volgende deck" Classes="heading" /><TextBlock Text="{Binding Progress}" Foreground="#E5A65D" /><TextBlock Text="{Binding CollectionSummary}" Classes="muted" TextWrapping="Wrap" /></StackPanel><Image Grid.Column="1" Source="avares://MTGDeckbuilder.Desktop/Assets/magic-mark.png" Width="60" Height="75" /></Grid>
  <Border Classes="card" IsVisible="{Binding IsStep0}"><StackPanel Spacing="15"><TextBlock Text="Hoe wil je spelen?" Classes="section" /><TextBlock Text="Geef je deck een naam en kies het formaat." Classes="muted" /><TextBox Name="WizardName" Text="{Binding Name}" MaxLength="120" PlaceholderText="Naam van je nieuwe deck" /><TextBlock Text="Formaat" /><ComboBox Name="WizardFormat" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" HorizontalAlignment="Stretch" /><TextBlock Text="Casual gebruikt de 60-kaartstructuur. Standard controleert ook actuele papierlegaliteit. Commander vraagt één geschikte commander en precies 100 kaarten." Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
  <Border Classes="card" IsVisible="{Binding IsStep1}"><StackPanel Spacing="15"><TextBlock Text="Welke kleuren mogen in je deck?" Classes="section" /><ComboBox Name="WizardColorMode" ItemsSource="{Binding ColorModes}" SelectedItem="{Binding SelectedColorMode}" HorizontalAlignment="Stretch" /><WrapPanel IsVisible="{Binding SelectColors}"><CheckBox Name="WizardWhite" IsChecked="{Binding White}" Foreground="#E8DFBA" Content="Wit" Margin="0,0,24,12" /><CheckBox Name="WizardBlue" IsChecked="{Binding Blue}" Foreground="#71B8DD" Content="Blauw" Margin="0,0,24,12" /><CheckBox Name="WizardBlack" IsChecked="{Binding Black}" Foreground="#B5A0C2" Content="Zwart" Margin="0,0,24,12" /><CheckBox Name="WizardRed" IsChecked="{Binding Red}" Foreground="#EC8B66" Content="Rood" Margin="0,0,24,12" /><CheckBox Name="WizardGreen" IsChecked="{Binding Green}" Foreground="#82BE8C" Content="Groen" Margin="0,0,24,12" /></WrapPanel><TextBlock Text="Dit begrenst de kleuridentiteit van je kaarten, inclusief regelsymbolen en achterzijden. Een commander kan de gekozen kleuren verder beperken. Kleurloos is een aparte, bewuste keuze." Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
  <Border Classes="card" IsVisible="{Binding IsStep2}"><StackPanel Spacing="15"><TextBlock Text="Welk thema en welke speelstijl zoek je?" Classes="section" /><TextBlock Text="Synergie / thema" /><ComboBox Name="WizardTheme" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch" /><TextBlock Text="Speelstijl" /><ComboBox Name="WizardStyle" ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}" HorizontalAlignment="Stretch" /><TextBlock Text="De wizard beoordeelt ondersteunde rollen, relaties en voorwaarden. Hij zoekt passende ondersteuning en bewaakt dragers en samenstelling. Nieuwe/onbekende kaartwerking blijft apart vermeld. Geen volledige combo-engine of speelsterktegarantie." Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
  <Border Classes="card" IsVisible="{Binding IsStep3}"><StackPanel Spacing="15"><TextBlock Text="Alleen eigen kaarten, of ook plannen?" Classes="section" /><TextBlock Text="Standaard gebruikt de wizard alleen je actieve fysieke voorraad. Bij onvoldoende passende kaarten volgt een melding." TextWrapping="Wrap" /><CheckBox Name="WizardPlanning" IsChecked="{Binding Planning}"><TextBlock Text="Planning toestaan: Scryfall mag ontbrekende kaarten aanvullen. Die kaarten worden geen bezit." TextWrapping="Wrap" /></CheckBox><StackPanel IsVisible="{Binding IsCommander}" Spacing="12"><TextBlock Text="Wie wordt je commander?" Classes="section" /><ComboBox Name="WizardCommander" ItemsSource="{Binding Commanders}" SelectedItem="{Binding SelectedCommander}" HorizontalAlignment="Stretch" /><TextBox Text="{Binding CommanderSearch}" PlaceholderText="Zoek een andere commander bij Scryfall" /><Button Content="Commanders zoeken" Command="{Binding SearchCommanderCommand}" HorizontalAlignment="Left" /><TextBlock Text="Eén ondersteunde commander; partner/background-paren en een vooraf te kiezen kleur worden niet automatisch opgebouwd." Classes="muted" TextWrapping="Wrap" /></StackPanel></StackPanel></Border>
  <Border Classes="card" IsVisible="{Binding IsStep4}"><StackPanel Spacing="14"><TextBlock Text="Bekijk je voorgestelde deck" Classes="section" /><TextBlock Name="WizardResultSummary" Text="{Binding Draft.Report.Summary}" Foreground="#E8B978" TextWrapping="Wrap" /><ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled"><TextBlock Name="WizardResultDetails" Text="{Binding Draft.Report.Details}" TextWrapping="Wrap" /></ScrollViewer><TextBlock Name="WizardSynergySummary" Text="{Binding Draft.Report.Synergy.Summary}" Classes="section" TextWrapping="Wrap" />
<TextBlock Text="{Binding Draft.Report.Synergy.ProfileSummary}" Classes="muted" TextWrapping="Wrap" />
<Expander Name="WizardSynergyPanel" Header="Bekijk synergie, voorwaarden en aandachtspunten" HorizontalAlignment="Stretch"><StackPanel Spacing="12">
<TextBlock Name="WizardSynergyWarnings" Text="{Binding Draft.Report.Synergy.WarningsText}" Foreground="#E8B978" TextWrapping="Wrap" />
<ListBox Name="WizardSynergyRelations" ItemsSource="{Binding Draft.Report.Synergy.Relations}" MaxHeight="300"><ListBox.ItemTemplate><DataTemplate x:DataType="app:SynergyRelation"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="4,8" /></DataTemplate></ListBox.ItemTemplate></ListBox>
<TextBlock Text="Alle relaties hebben voorwaarden. Basiscombinaties zijn geen bewezen strategische synergie. Kaarten in je deck zijn niet automatisch tegelijk beschikbaar of op het slagveld." Classes="muted" TextWrapping="Wrap" />
</StackPanel></Expander><ListBox Name="WizardResultCards" ItemsSource="{Binding Draft.Lines}" MaxHeight="230"><ListBox.ItemTemplate><DataTemplate x:DataType="app:PaperDeckLine"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="4,5" /></DataTemplate></ListBox.ItemTemplate></ListBox><CheckBox Name="WizardConfirm" IsChecked="{Binding Confirm}" IsEnabled="{Binding !IsSaved}"><TextBlock Text="Ik heb de volledige lijst, voorwaarden en tekorten bekeken en wil dit als nieuw deck opslaan." TextWrapping="Wrap" /></CheckBox><Button Name="WizardSave" Content="Nieuw deck opslaan" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsSaved}" Classes="primary" HorizontalAlignment="Left" /><TextBlock Text="{Binding SavedMessage}" Foreground="#A9D6A8" TextWrapping="Wrap" /><Button Content="Open mijn nieuwe deck" Command="{Binding OpenSavedCommand}" IsVisible="{Binding IsSaved}" HorizontalAlignment="Left" /></StackPanel></Border>
  <WrapPanel><Button Name="WizardBack" Content="Vorige stap" Command="{Binding BackCommand}" IsEnabled="{Binding CanBack}" Margin="0,0,12,0" /><Button Name="WizardNext" Content="{Binding NextLabel}" Command="{Binding NextCommand}" IsVisible="{Binding !IsStep4}" Classes="primary" /></WrapPanel>
 </StackPanel>
</UserControl>


